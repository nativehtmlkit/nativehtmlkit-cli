{
  "schema_version": 1,
  "title": "Create task",
  "description": "Collect task parameters.",
  "fields": [
    {
      "id": "name",
      "type": "text",
      "label": "Task name",
      "required": true,
      "minlength": 2
    },
    {
      "id": "priority",
      "type": "select",
      "label": "Priority",
      "required": true,
      "options": [
        {
          "value": "low",
          "label": "Low"
        },
        {
          "value": "high",
          "label": "High"
        }
      ]
    },
    {
      "id": "dry_run",
      "type": "checkbox",
      "label": "Dry run",
      "default": true
    }
  ]
}
