{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nativehtmlkit:cli:form:v1",
  "title": "Declarative CLI Form V1 (proposed P3)",
  "type": "object",
  "required": [
    "schema_version",
    "title",
    "fields"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "description": {
      "type": "string",
      "maxLength": 2048
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "required": [
          "id",
          "type",
          "label"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$"
          },
          "type": {
            "type": "string",
            "enum": [
              "text",
              "textarea",
              "number",
              "checkbox",
              "radio",
              "select",
              "multiselect",
              "password"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "required": {
            "type": "boolean"
          },
          "sensitive": {
            "type": "boolean"
          },
          "default": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "number"
              },
              {
                "type": "boolean"
              },
              {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "min": {
            "type": "number"
          },
          "max": {
            "type": "number"
          },
          "step": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "minlength": {
            "type": "integer",
            "minimum": 0
          },
          "maxlength": {
            "type": "integer",
            "minimum": 0
          },
          "pattern": {
            "type": "string",
            "maxLength": 512
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "items": {
              "type": "object",
              "required": [
                "value",
                "label"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "maxLength": 4096
                },
                "label": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 256
                }
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "type": {
                  "const": "password"
                }
              }
            },
            "then": {
              "required": [
                "sensitive"
              ],
              "properties": {
                "sensitive": {
                  "const": true
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "type": {
                  "enum": [
                    "radio",
                    "select",
                    "multiselect"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "options"
              ]
            }
          }
        ]
      }
    }
  }
}
