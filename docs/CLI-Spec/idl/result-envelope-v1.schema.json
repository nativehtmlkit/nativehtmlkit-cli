{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nativehtmlkit:cli:result-envelope:v1",
  "title": "Optional --output result-json Submitted Envelope V1",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "status"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "select",
        "input",
        "confirm",
        "form"
      ]
    },
    "status": {
      "const": "submitted"
    },
    "selected_indices": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "selected": {
      "type": "array",
      "items": true
    },
    "values": {
      "type": "object",
      "additionalProperties": true
    },
    "value": {
      "type": "string"
    },
    "accepted": {
      "const": true
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "select"
          }
        }
      },
      "then": {
        "required": [
          "selected_indices",
          "selected"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "values"
              ]
            },
            {
              "required": [
                "value"
              ]
            },
            {
              "required": [
                "accepted"
              ]
            }
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "form"
          }
        }
      },
      "then": {
        "required": [
          "values"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "input"
          }
        }
      },
      "then": {
        "required": [
          "value"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "confirm"
          }
        }
      },
      "then": {
        "required": [
          "accepted"
        ]
      }
    }
  ]
}
