{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:nativehtmlkit:cli:invocation:v1",
  "title": "Normalized CLI Invocation V1 (proposed)",
  "type": "object",
  "required": [
    "schema_version",
    "kind"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "type": "string",
      "enum": [
        "select",
        "view",
        "input",
        "confirm",
        "form"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "input": {
      "type": "object",
      "required": [
        "format",
        "source"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "lines",
            "text",
            "csv",
            "tsv",
            "json",
            "ndjson"
          ]
        },
        "source": {
          "type": "string",
          "enum": [
            "stdin",
            "file",
            "none"
          ]
        },
        "file_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "source": {
                "const": "file"
              }
            }
          },
          "then": {
            "required": [
              "file_path"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "enum": [
                  "stdin",
                  "none"
                ]
              }
            }
          },
          "then": {
            "not": {
              "required": [
                "file_path"
              ]
            }
          }
        }
      ]
    },
    "output": {
      "type": "object",
      "required": [
        "format"
      ],
      "additionalProperties": false,
      "properties": {
        "format": {
          "type": "string",
          "enum": [
            "same",
            "lines",
            "json",
            "ndjson",
            "csv",
            "tsv",
            "values",
            "result-json"
          ]
        }
      }
    },
    "selection": {
      "type": "object",
      "required": [
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "mode": {
          "type": "string",
          "enum": [
            "single",
            "multiple"
          ]
        },
        "min": {
          "type": "integer",
          "minimum": 0
        },
        "max": {
          "type": "integer",
          "minimum": 1
        },
        "allow_empty": {
          "type": "boolean"
        },
        "value_field": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      }
    },
    "ui": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "theme": {
          "type": "string",
          "enum": [
            "system",
            "dark",
            "light"
          ]
        },
        "search": {
          "type": "string",
          "maxLength": 1024
        },
        "page_size": {
          "type": "integer",
          "enum": [
            25,
            50
          ]
        }
      }
    },
    "form_spec": {
      "type": "object",
      "description": "Matches form-v1.schema.json; validate separately for portability"
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "kind": {
            "const": "select"
          }
        }
      },
      "then": {
        "required": [
          "input",
          "output",
          "selection"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "kind": {
            "const": "view"
          }
        }
      },
      "then": {
        "required": [
          "input"
        ]
      }
    }
  ]
}
